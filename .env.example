# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or anywhere in the repo.

# Your public website address (no trailing slash). Used for referral links.
SITE_URL=https://www.fakefanatic.com

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-secret-here

# Nitrosend → Settings → API keys
NITROSEND_API_KEY=paste-your-nitrosend-key-here

# Any long random string. Used to hash IP addresses for rate limiting.
IP_HASH_SALT=change-me-to-a-long-random-string
